{
    "$schema": "http://json-schema.org/schema#",
    "type": "object",
    "properties": {
        "nameOverride": { "type": "string" },
        "fullnameOverride": { "type": "string" },
        "kyverno-playground": {
            "type": "object",
            "properties": {
                "image": {
                    "type": "object",
                    "properties": {
                        "registry": { "type": "string" },
                        "repository": { "type": "string" },
                        "pullPolicy": { "type": "string" },
                        "tag": { "type": ["string", "null"] }
                    }
                },
                "nameOverride": { "type": "string" },
                "fullnameOverride": { "type": "string" },
                "replicaCount": { "type": "integer", "minimum": 0 },
                "sponsor": { "type": "string" },
                "tufRootMountPath": { "type": "string" },
                "imagePullSecrets": { "type": "array", "items": { "type": "object" } },
                "priorityClassName": { "type": "string" },
                "serviceAccount": {
                    "type": "object",
                    "properties": {
                        "create": { "type": "boolean" },
                        "annotations": { "type": "object" },
                        "name": { "type": "string" }
                    }
                },
                "podAnnotations": { "type": "object" },
                "podLabels": { "type": "object" },
                "global": {
                    "type": "object",
                    "properties": { "labels": { "type": "object" } }
                },
                "podSecurityContext": { "type": "object" },
                "securityContext": { "type": "object" },
                "service": {
                    "type": "object",
                    "properties": {
                        "type": { "type": "string" },
                        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
                    }
                },
                "httproute": {
                    "type": "object",
                    "properties": {
                        "enabled": { "type": "boolean" },
                        "labels": { "type": "object" },
                        "annotations": { "type": "object" },
                        "parentRefs": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "name": { "type": "string" },
                                    "namespace": { "type": "string" },
                                    "sectionName": { "type": "string" }
                                }
                            }
                        },
                        "hostnames": { "type": "array", "items": { "type": "string" } },
                        "rules": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "matches": {
                                        "type": "array",
                                        "items": {
                                            "type": "object",
                                            "properties": {
                                                "path": {
                                                    "type": "object",
                                                    "properties": {
                                                        "type": { "type": "string" },
                                                        "value": { "type": "string" }
                                                    }
                                                }
                                            }
                                        }
                                    },
                                    "filters": { "type": "array", "items": { "type": "object" } },
                                    "timeouts": {
                                        "type": "object",
                                        "properties": {
                                            "request": { "type": "string" },
                                            "backendRequest": { "type": "string" }
                                        }
                                    }
                                }
                            }
                        }
                    }
                },
                "livenessProbe": { "type": "object" },
                "readinessProbe": { "type": "object" },
                "resources": {
                    "type": "object",
                    "properties": {
                        "limits": { "type": ["object", "null"] },
                        "requests": { "type": ["object", "null"] }
                    }
                },
                "autoscaling": {
                    "type": "object",
                    "properties": {
                        "enabled": { "type": "boolean" },
                        "minReplicas": { "type": "integer", "minimum": 0 },
                        "maxReplicas": { "type": "integer", "minimum": 0 },
                        "targetCPUUtilizationPercentage": { "type": "integer", "minimum": 0 },
                        "targetMemoryUtilizationPercentage": { "type": ["integer", "null"], "minimum": 0 }
                    }
                },
                "nodeSelector": { "type": "object" },
                "tolerations": { "type": "array", "items": { "type": "object" } },
                "affinity": { "type": "object" },
                "networkPolicy": {
                    "type": "object",
                    "properties": {
                        "enabled": { "type": "boolean" },
                        "allowClusterDNS": { "type": "boolean" }
                    }
                },
                "clusterRoles": { "type": "array", "items": { "type": "object" } },
                "roles": { "type": "array", "items": { "type": "object" } },
                "extraArgs": { "type": "object" },
                "config": {
                    "type": "object",
                    "properties": {
                        "gin": {
                            "type": "object",
                            "properties": {
                                "mode": { "type": "string", "enum": ["release", "debug"] },
                                "cors": { "type": "boolean" },
                                "logger": { "type": "boolean" },
                                "maxBodySize": { "type": "integer", "minimum": 0 }
                            }
                        },
                        "server": {
                            "type": "object",
                            "properties": {
                                "host": { "type": "string" },
                                "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
                            }
                        },
                        "cluster": {
                            "type": "object",
                            "properties": { "enabled": { "type": "boolean" } }
                        },
                        "ui": {
                            "type": "object",
                            "properties": { "sponsor": { "type": "string" } }
                        },
                        "engine": {
                            "type": "object",
                            "properties": {
                                "builtinCrds": { "type": "array", "items": { "type": "string" } },
                                "localCrds": { "type": "array", "items": { "type": "string" } }
                            }
                        },
                        "versions": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "name": { "type": "string" },
                                    "url": { "type": "string", "format": "uri" }
                                }
                            }
                        }
                    }
                },
                "mcp": {
                    "type": "object",
                    "properties": {
                        "enabled": { "type": "boolean" },
                        "replicaCount": { "type": "integer", "minimum": 0 },
                        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
                        "service": {
                            "type": "object",
                            "properties": {
                                "type": { "type": "string" },
                                "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
                            }
                        },
                        "ingress": {
                            "type": "object",
                            "properties": {
                                "enabled": { "type": "boolean" },
                                "className": { "type": "string" },
                                "annotations": { "type": "object" },
                                "hosts": { "type": "array", "items": { "type": "object" } },
                                "tls": { "type": "array", "items": { "type": "object" } }
                            }
                        },
                        "httproute": {
                            "type": "object",
                            "properties": {
                                "enabled": { "type": "boolean" },
                                "labels": { "type": "object" },
                                "annotations": { "type": "object" },
                                "parentRefs": {
                                    "type": "array",
                                    "items": {
                                        "type": "object",
                                        "properties": {
                                            "name": { "type": "string" },
                                            "namespace": { "type": "string" },
                                            "sectionName": { "type": "string" }
                                        }
                                    }
                                },
                                "hostnames": { "type": "array", "items": { "type": "string" } },
                                "rules": {
                                    "type": "array",
                                    "items": {
                                        "type": "object",
                                        "properties": {
                                            "matches": {
                                                "type": "array",
                                                "items": {
                                                    "type": "object",
                                                    "properties": {
                                                        "path": {
                                                            "type": "object",
                                                            "properties": {
                                                                "type": { "type": "string" },
                                                                "value": { "type": "string" }
                                                            }
                                                        }
                                                    }
                                                }
                                            },
                                            "filters": { "type": "array", "items": { "type": "object" } },
                                            "timeouts": {
                                                "type": "object",
                                                "properties": {
                                                    "request": { "type": "string" },
                                                    "backendRequest": { "type": "string" }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        },
                        "resources": {
                            "type": "object",
                            "properties": {
                                "limits": { "type": ["object", "null"] },
                                "requests": { "type": ["object", "null"] }
                            }
                        }
                    }
                }
            }
        }
    }
}